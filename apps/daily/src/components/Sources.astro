---
import type { Source } from "../lib/digests"
interface Props { sources: Source[] }
const { sources } = Astro.props
---
<p class="source">{sources.length === 1 ? "Source: " : "Sources: "}{sources.map((source, index) => <Fragment>{index > 0 && ", "}<a href={source.url}>{source.label}</a></Fragment>)}</p>
