<div class="adjust" role="group" aria-label="Reading controls">
  <button type="button" data-size="-1" aria-label="Decrease text size" hidden>A−</button>
  <button type="button" data-size="1" aria-label="Increase text size" hidden>A+</button>
  <button type="button" data-print hidden>Print</button>
  <span id="reader-status" class="sr-only" role="status" aria-live="polite"></span>
</div>
