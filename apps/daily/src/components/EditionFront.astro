---
import type { Edition } from "../lib/digests"
import StoryCard from "./StoryCard.astro"
import ArchivedLinks from "./ArchivedLinks.astro"
import ReaderTools from "./ReaderTools.astro"
import { editionDate } from "./format"
interface Props { edition: Edition }
const { edition } = Astro.props
const secondary = edition.kind === "identified" ? edition.activeStories.filter((story) => story.kind === "story" && story.id !== edition.lead.id) : []
const briefs = edition.kind === "identified" ? edition.activeStories.filter((story) => story.kind === "brief") : []
---
{edition.kind === "identified" ? <>
  <div class="front-reader-tools"><a href={edition.readPath}>Read full edition</a><ReaderTools /></div>
  <div class:list={["front-grid", { "single-story": edition.activeStories.length === 1, "without-briefs": briefs.length === 0 }]}>
    <section class="front-main" aria-label="Main stories">
      <StoryCard story={edition.lead} lead />
      {secondary.length > 0 && <div class="secondary-stories">{secondary.map((story) => <StoryCard story={story} />)}</div>}
    </section>
    {briefs.length > 0 && <aside class="brief-column" aria-label="In brief">
      <h2 class="brief-heading" id="in-brief">In brief</h2>
      {briefs.map((story) => <StoryCard story={story} />)}
    </aside>}
  </div>
  <ArchivedLinks stories={edition.archivedStories} />
  <div class="front-actions"><a href={edition.readPath}>Read the full edition</a><a href="/rss.xml">Get the next edition with RSS</a></div>
</> : <article class="reader legacy">
  <div class="reader-top"><span>Full edition</span><ReaderTools /></div>
  <h1 class="sr-only">{editionDate(edition.date)}</h1>
  <div class="reading-copy" set:html={edition.html} />
</article>}
