---
import Paper from "../layouts/Paper.astro"
import EditionLine from "../components/EditionLine.astro"
import EditionFront from "../components/EditionFront.astro"
import { editionDate } from "../components/format"
import { loadEditions } from "../lib/digests"
const edition = (await loadEditions())[0]
---
<Paper title={edition ? editionDate(edition.date) : "Latest edition"} canonical={edition?.path ?? "/"}>
  {edition && <EditionLine slot="editionline" edition={edition} />}
  {edition ? <EditionFront edition={edition} /> : <div class="archive"><h1>The AI daily</h1><p>No editions have been published yet.</p></div>}
</Paper>
