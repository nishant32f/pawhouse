---
import Paper from "../../../../../layouts/Paper.astro"
import { renderVisual } from "../../../../../components/visuals"
import ReaderTools from "../../../../../components/ReaderTools.astro"
import { editionDate } from "../../../../../components/format"
import { loadEditions, type IdentifiedEdition, type Story } from "../../../../../lib/digests"
export async function getStaticPaths() {
  return (await loadEditions()).flatMap((edition) => edition.kind === "identified" ? edition.stories.map((story) => ({ params: { date: edition.date, id: story.id }, props: { edition, story } })) : [])
}
interface Props { edition: IdentifiedEdition; story: Story }
const { edition, story } = Astro.props
const position = edition.activeStories.findIndex((active) => active.id === story.id)
const previous = position > 0 ? edition.activeStories[position - 1] : undefined
const next = position >= 0 ? edition.activeStories[position + 1] : undefined
---
<Paper title={story.headline} description={story.summary} canonical={story.path} compact>
  <article class="reader">
    <div class="reader-top"><a href={edition.path}>Back to edition</a><ReaderTools /></div>
    <p class="article-meta"><time datetime={edition.date}>{editionDate(edition.date)}</time>{story.kind === "brief" && " · In brief"}{story.kind === "archived" && " · Archived story"}</p>
    {story.editorial && <p class="kicker">{story.editorial.section}</p>}
    <h1>{story.headline}</h1>
    {story.editorial?.deck && <p class="deck">{story.editorial.deck}</p>}
    {story.editorial?.visual && <Fragment set:html={renderVisual(story.editorial.visual)} />}
    <div class:list={["reading-copy", { "story-copy": story.kind !== "archived", "archived-copy": story.kind === "archived" }]} set:html={story.html} />
    {(previous || next) && <nav class="story-nav" aria-label="Story navigation">
      <div>{previous && <a rel="prev" href={previous.path}><span>Previous story</span>{previous.headline}</a>}</div>
      <div class="next">{next && <a rel="next" href={next.path}><span>Next story</span>{next.headline}</a>}</div>
    </nav>}
    <p class="back-link"><a href={edition.path}>Back to edition</a> · <a href={edition.readPath}>Read full edition</a></p>
  </article>
</Paper>
