---
import Paper from "../../../../layouts/Paper.astro"
import { renderVisual } from "../../../../components/visuals"
import ArchivedLinks from "../../../../components/ArchivedLinks.astro"
import ReaderTools from "../../../../components/ReaderTools.astro"
import { editionDate } from "../../../../components/format"
const edition = await Astro.locals.publication.edition(Astro.params.date)
if (!edition) return Astro.rewrite("/404")
const firstBrief = edition.kind === "identified" ? edition.activeStories.find((story) => story.kind === "brief") : undefined
---
<Paper title={`Full edition, ${editionDate(edition.date)}`} canonical={edition.readPath} compact>
  <article class="reader full-edition">
    <div class="reader-top"><a href={edition.path}>Back to edition</a><ReaderTools /></div>
    <p class="article-meta"><time datetime={edition.date}>{editionDate(edition.date)}</time></p>
    <h1>Full edition</h1>
    {edition.kind === "identified" ? edition.activeStories.map((story) => <section class="full-story" id={story.id}>
      {story.legacyAnchor !== story.id && <span id={story.legacyAnchor} />}
      {(story.editorial || story.kind === "brief") && <p class="kicker" id={story.id === firstBrief?.id ? "in-brief" : undefined}>{story.editorial?.section ?? "In brief"}</p>}
      <h2><a href={story.path}>{story.headline}</a></h2>
      {story.editorial?.deck && <p class="deck">{story.editorial.deck}</p>}
      {story.editorial?.visual && <Fragment set:html={renderVisual(story.editorial.visual)} />}
      <div class="reading-copy" set:html={story.html} />
    </section>) : <div class="reading-copy" set:html={edition.html} />}
    {edition.kind === "identified" && <ArchivedLinks stories={edition.archivedStories} />}
    <p class="back-link"><a href={edition.path}>Back to edition</a></p>
  </article>
</Paper>
