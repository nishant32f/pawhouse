---
import Paper from "../../layouts/Paper.astro"
import { editionDate } from "../../components/format"
const { documents } = await Astro.locals.publication.search()
const { editions } = await Astro.locals.publication.catalog()
const archived = new Set(editions.flatMap((edition) => edition.stories.filter((story) => story.kind === "archived").map((story) => story.path)))
const query = Astro.url.searchParams.get("q")?.trim().toLocaleLowerCase() ?? ""
const words = query.split(/\s+/).filter(Boolean)
const entries = documents.map((document) => {
  const searchText = `${editionDate(document.date)} ${document.title} ${document.text}`
  const normalized = words.length ? searchText.toLocaleLowerCase() : ""
  return { ...document, searchText, matches: words.every((word) => normalized.includes(word)) }
})
const matchCount = entries.filter((entry) => entry.matches).length
---
<Paper title="Search" compact>
  <div class="archive search"><h1>Search the daily</h1>
    <p id="search-guidance">Search headlines and full text, or browse every edition below.</p>
    <form role="search" id="search-form">
      <label for="search-query">Search editions and stories</label>
      <div class="search-input"><input type="search" id="search-query" name="q" aria-describedby="search-guidance" autocomplete="off" value={query} /><button type="submit">Search</button></div>
    </form>
    <p role="status" aria-live="polite" id="search-status">{query && `${matchCount} ${matchCount === 1 ? "match" : "matches"}`}</p>
    <p id="no-matches" hidden={matchCount !== 0}>No matches. Try fewer words, or <a href="/archive/">browse the edition archive</a>.</p>
    <ul class="search-results">{entries.map((document) => <li data-search={document.searchText} hidden={!document.matches}><a href={document.path}>{document.path === `/editions/${document.date}/` ? `${editionDate(document.date)} · Full edition` : document.title}</a>{document.path !== `/editions/${document.date}/` && <span>{editionDate(document.date)}{archived.has(document.path) && " · Archived story"}</span>}<span class="sr-only">{document.text}</span></li>)}</ul>
    <noscript><p>Use your browser's Find command to find a headline, or follow any edition link above.</p></noscript>
  </div>
</Paper>
<script>
  const form = document.querySelector<HTMLFormElement>("#search-form")
  const input = document.querySelector<HTMLInputElement>("#search-query")
  const status = document.querySelector("#search-status")
  const empty = document.querySelector<HTMLElement>("#no-matches")
  const entries = Array.from(document.querySelectorAll<HTMLElement>("[data-search]"))
  const filter = () => {
    const query = input?.value.trim().toLocaleLowerCase() ?? ""
    const words = query.split(/\s+/).filter(Boolean)
    let count = 0
    for (const entry of entries) {
      const text = entry.dataset.search?.toLocaleLowerCase() ?? ""
      entry.hidden = !words.every((word) => text.includes(word))
      if (!entry.hidden) count++
    }
    if (status) status.textContent = query ? `${count} ${count === 1 ? "match" : "matches"}` : "All editions and stories"
    if (empty) empty.hidden = count !== 0
  }
  if (input) input.value = new URLSearchParams(window.location.search).get("q") ?? ""
  input?.addEventListener("input", filter)
  form?.addEventListener("submit", (event) => { event.preventDefault(); filter() })
  filter()
</script>
